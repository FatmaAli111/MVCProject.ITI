@model dynamic
@{
    var currentPage = (int)Model.CurrentPage;
    var totalPages = (int)Model.TotalPages;
    var hasPrevious = (bool)Model.HasPreviousPage;
    var hasNext = (bool)Model.HasNextPage;
}
@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination admin-pagination justify-content-center mb-0">
            <li class="page-item @(!hasPrevious ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-route-page="@(currentPage - 1)"
                   asp-route-search="@ViewBag.Search">Previous</a>
            </li>
            @for (var i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-action="@ViewContext.RouteData.Values["action"]"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
            <li class="page-item @(!hasNext ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-route-page="@(currentPage + 1)"
                   asp-route-search="@ViewBag.Search">Next</a>
            </li>
        </ul>
        <p class="text-center text-muted small mt-2 mb-0">Page @currentPage of @totalPages (@Model.TotalCount total)</p>
    </nav>
}

