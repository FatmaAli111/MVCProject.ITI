@model PaginatedResult<AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = "Manage accounts and roles";
}
<div class="admin-card mb-3">
    <div class="admin-card-header">
        <h2>All Users</h2>
        <form method="get" class="d-flex gap-2 admin-search">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search email or name..." />
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Roles</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model.Data)
            {
                <tr>
                    <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "—" : u.FullName)</td>
                    <td>@u.Email</td>
                    <td>
                        @foreach (var role in u.Roles) { <span class="admin-badge admin-badge-primary me-1">@role</span> }
                        @if (!u.Roles.Any()) { <span class="text-muted">User</span> }
                    </td>
                    <td>
                        @if (u.IsLockedOut) { <span class="admin-badge admin-badge-danger">Locked</span> }
                        else if (u.EmailConfirmed) { <span class="admin-badge admin-badge-success">Active</span> }
                        else { <span class="admin-badge admin-badge-warning">Unverified</span> }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary admin-btn-icon" title="Details"><i class="bi bi-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary admin-btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("_Pagination", Model)
