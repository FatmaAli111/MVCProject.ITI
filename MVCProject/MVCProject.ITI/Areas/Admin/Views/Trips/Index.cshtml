@model PaginatedResult<AdminTripListItemViewModel>
@{ ViewData["Title"] = "Trips"; ViewData["Subtitle"] = "All platform trips"; }
<div class="admin-card">
    <div class="admin-card-header">
        <h2>Trips</h2>
        <form method="get" class="d-flex gap-2 admin-search">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Route or user..." />
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead><tr><th>Route</th><th>User</th><th>km</th><th>Date</th><th></th></tr></thead>
            <tbody>
            @foreach (var t in Model.Data)
            {
                <tr>
                    <td>@t.OriginName &rarr; @t.DestinationName</td>
                    <td class="small text-muted">@t.UserEmail</td>
                    <td>@t.DistanceKm.ToString("N1")</td>
                    <td>@t.TripDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary admin-btn-icon"><i class="bi bi-eye"></i></a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this trip?');">
                            <input type="hidden" name="id" value="@t.Id" />@Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger admin-btn-icon"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("_Pagination", Model)
