@model PaginatedResult<AdminVehicleListItemViewModel>
@{ ViewData["Title"] = "Vehicles"; ViewData["Subtitle"] = "User garage vehicles"; }
<div class="admin-card">
    <div class="admin-card-header">
        <h2>Vehicles</h2>
        <form method="get" class="d-flex gap-2 admin-search">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search..." />
            <button type="submit" class="btn btn-sm btn-primary">Search</button>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead><tr><th>Nickname</th><th>Car</th><th>Owner</th><th>Trips</th><th></th></tr></thead>
            <tbody>
            @foreach (var v in Model.Data)
            {
                <tr>
                    <td>@v.NickName @if (v.IsDefault) { <span class="admin-badge admin-badge-primary">Default</span> }</td>
                    <td>@v.Make @v.Model</td>
                    <td class="small text-muted">@v.OwnerEmail</td>
                    <td>@v.TripCount</td>
                    <td class="text-end">
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete vehicle?');">
                            <input type="hidden" name="id" value="@v.Id" />@Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger admin-btn-icon" disabled="@(v.TripCount > 0)"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("_Pagination", Model)
