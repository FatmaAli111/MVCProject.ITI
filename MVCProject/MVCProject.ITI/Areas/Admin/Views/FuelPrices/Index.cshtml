@model PaginatedResult<AdminFuelPriceViewModel>
@{ ViewData["Title"] = "Fuel Prices"; }
<div class="admin-card">
    <div class="admin-card-header"><h2>Fuel Prices</h2><a asp-action="Create" class="btn btn-sm btn-primary gradient-bg border-0"><i class="bi bi-plus-lg"></i> Add</a></div>
    <div class="table-responsive">
        <table class="table admin-table mb-0">
            <thead><tr><th>Type</th><th>Region</th><th>Price</th><th>Currency</th><th>Date</th><th></th></tr></thead>
            <tbody>
            @foreach (var f in Model.Data)
            {
                <tr>
                    <td>@f.FuelType</td><td>@f.Region</td><td>@f.PricePerUnit</td><td>@f.Currency</td><td>@f.RecordedDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary admin-btn-icon"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete?');">
                            <input type="hidden" name="id" value="@f.Id" />@Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger admin-btn-icon"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
@await Html.PartialAsync("_Pagination", Model)
