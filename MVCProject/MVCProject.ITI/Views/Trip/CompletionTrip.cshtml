
<div class="page active" id="page-trip">
    <div class="topbar">
        <div class="tb-left">
            <button class="back-btn" onclick="showHistory()">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <div class="tb-title">
                <h2>Trip Complete</h2>
                <p>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="10" r="3" /><path d="M12 2a8 8 0 018 8c0 6-8 14-8 14S4 16 4 10a8 8 0 018-8z" /></svg>
                    Cairo → Alexandria
                </p>
            </div>
        </div>
        <div class="tb-acts">
            <button class="icon-btn icon-btn-teal" onclick="openMapModal()">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /><line x1="8" y1="2" x2="8" y2="18" /><line x1="16" y1="6" x2="16" y2="22" /></svg>
            </button>
            <button class="icon-btn icon-btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2" stroke-linecap="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" /></svg>
            </button>
        </div>
    </div>

    <div class="page-scroll">
        <!-- HERO -->
        <div class="hero-card" style="margin-top:14px;">
            <div class="hc-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                Total Trip Cost
            </div>
            <div class="hc-amount">EGP 352</div>
            <div class="hc-row">
                <button class="plan-btn" onclick="showHistory()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                    Plan Another Trip
                </button>
                <div class="dollar-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
                </div>
            </div>
            <div class="car-row">
                <div class="car-info">
                    <div class="car-av">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="2" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                    </div>
                    <div>
                        <div class="car-name">Toyota Corolla</div>
                        <div class="car-sub">8.5L/100km</div>
                    </div>
                </div>
                <div class="verified">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                    Verified
                </div>
            </div>
        </div>

        <!-- STATS -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="si" style="background:#E6FAF8;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="10" r="3" /><path d="M12 2a8 8 0 018 8c0 6-8 14-8 14S4 16 4 10a8 8 0 018-8z" /></svg>
                </div>
                <div class="sv">220</div><div class="sl">Distance</div>
            </div>
            <div class="stat-card">
                <div class="si" style="background:#F5F3FF;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                </div>
                <div class="sv" style="font-size:14px;">2h 30m</div><div class="sl">Duration</div>
            </div>
            <div class="stat-card">
                <div class="si" style="background:#FFF7ED;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2.3" stroke-linecap="round"><path d="M5 22V4a2 2 0 012-2h6a2 2 0 012 2v18" /><path d="M5 10H15" /><path d="M19 10l.92-.92a2 2 0 012.83 0L23 10v6a2 2 0 01-2 2h-2" /></svg>
                </div>
                <div class="sv">234</div><div class="sl">Fuel</div>
            </div>
            <div class="stat-card">
                <div class="si" style="background:#ECFDF5;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.3" stroke-linecap="round"><path d="M12 22a10 10 0 100-20 10 10 0 000 20z" /><path d="M8.5 8.5s1-1 3.5-1 3.5 1 3.5 1" /><path d="M8.5 14.5s1 1 3.5 1 3.5-1 3.5-1" /><line x1="12" y1="6" x2="12" y2="8" /><line x1="12" y1="16" x2="12" y2="18" /></svg>
                </div>
                <div class="sv">45.2</div><div class="sl">CO₂</div>
            </div>
        </div>

        <!-- DRIVE VS RIDE-SHARE -->
        <div class="sc" style="animation-delay:.05s;">
            <div class="sh" onclick="toggleSec(this)">
                <div class="sh-left">
                    <div class="sico" style="background:#E6FAF8;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.2" stroke-linecap="round"><rect x="1" y="3" width="15" height="13" rx="2" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                    </div>
                    <div class="s-title">Drive vs Ride-Share</div>
                </div>
                <svg class="chev open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="sb" style="max-height:200px;">
                <div class="dvr-grid">
                    <div class="dvo best"><div class="best-badge">Best Choice</div><div class="dv-lbl" style="color:rgba(255,255,255,.8);">Your Car</div><div class="dv-price">EGP 352</div></div>
                    <div class="dvo"><div class="dv-lbl">Uber</div><div class="dv-price">EGP 850</div><div class="dv-diff">+EGP 498</div></div>
                    <div class="dvo"><div class="dv-lbl">Taxi</div><div class="dv-price">EGP 750</div><div class="dv-diff">+EGP 398</div></div>
                </div>
            </div>
        </div>

        <!-- TRAFFIC + COST SPLIT -->
        <div class="two-col">
            <div class="mini-card" style="animation-delay:.1s;">
                <div class="m-lbl"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--orange)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>Traffic</div>
                <div class="tr-name"><svg width="11" height="11" viewBox="0 0 24 24" fill="var(--orange)"><circle cx="12" cy="12" r="10" /></svg>Medium</div>
                <div class="tr-num">1.2x</div>
                <div class="tr-sub">time impact</div>
            </div>
            <div class="mini-card" style="animation-delay:.14s;">
                <div class="m-lbl">Cost Split</div>
                <div class="cs-row"><div class="cs-dot" style="background:var(--teal)"></div><div class="cs-nm">Fuel</div><div class="cs-vl">EGP 234</div></div>
                <div class="cs-row"><div class="cs-dot" style="background:var(--purple)"></div><div class="cs-nm">Tolls</div><div class="cs-vl">EGP 85</div></div>
                <div class="cs-row"><div class="cs-dot" style="background:var(--orange)"></div><div class="cs-nm">Maint.</div><div class="cs-vl">EGP 33</div></div>
            </div>
        </div>

        <!-- BEST TIME TO TRAVEL -->
        <div class="sc" style="animation-delay:.15s;">
            <div class="sh" onclick="toggleSec(this)">
                <div class="sh-left">
                    <div class="sico" style="background:#F5F3FF;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    </div>
                    <div>
                        <div class="s-title">Best Time to Travel</div>
                        <div class="s-sub">AI-powered recommendations</div>
                    </div>
                </div>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="sb" style="max-height:0;">
                <div class="btt-ai">
                    <div class="btt-ai-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--teal-dk)" stroke-width="2.5" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                    </div>
                    <div>
                        <div class="btt-ai-title">AI Recommendation <span class="ai-pill">AI Powered</span></div>
                        <div class="btt-ai-desc">Leave at <span class="ht">05:00</span> to save <span class="hg">EGP 70</span> and <span class="hg">37m</span></div>
                    </div>
                </div>

                <!-- 05:00 Best -->
                <div class="time-row">
                    <div class="ti" style="background:#ECFDF5;"><svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">05:00</span><span class="t-name">Early Morning</span><span class="t-bdg bdg-best">Best Choice</span></div>
                        <div class="t-desc">Minimal traffic, fastest route times</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>1h 53m</div><div class="t-save ts-g">↓ Save EGP 70</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <!-- 06:30 Good -->
                <div class="time-row">
                    <div class="ti" style="background:#E6FAF8;"><svg viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">06:30</span><span class="t-name">Sunrise</span><span class="t-bdg bdg-good">Good Option</span></div>
                        <div class="t-desc">Light traffic starting to build</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>2h 8m</div><div class="t-save ts-g">↓ Save EGP 42</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <!-- 08:00 Avoid -->
                <div class="time-row avoid">
                    <div class="ti" style="background:#FEE2E2;"><svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">08:00</span><span class="t-name">Morning Rush</span><span class="t-bdg bdg-avoid">Avoid</span></div>
                        <div class="t-desc">Peak rush hour, heavy congestion</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>3h 30m</div><div class="t-save ts-r">△ Extra EGP 88</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <!-- 10:00 -->
                <div class="time-row">
                    <div class="ti" style="background:#FFF7ED;"><svg viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">10:00</span><span class="t-name">Mid-Morning</span></div>
                        <div class="t-desc">Moderate traffic, reasonable travel time</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>2h 45m</div><div class="t-save ts-g">↓ Save EGP 18</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <!-- 12:00 base -->
                <div class="time-row base-cost">
                    <div class="ti" style="background:#FEF9C3;"><svg viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">12:00</span><span class="t-name">Noon</span></div>
                        <div class="t-desc">Lunch traffic, slightly congested</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>2h 53m</div><div class="t-save ts-b">Base cost</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <!-- 14:00 Good -->
                <div class="time-row">
                    <div class="ti" style="background:#E6FAF8;"><svg viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">14:00</span><span class="t-name">Afternoon</span><span class="t-bdg bdg-good">Good Option</span></div>
                        <div class="t-desc">Post-lunch lull, good traffic flow</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>2h 15m</div><div class="t-save ts-g">↓ Save EGP 28</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>

                <!-- 17:00 Avoid -->
                <div class="time-row avoid">
                    <div class="ti" style="background:#FEE2E2;"><svg viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2.3" stroke-linecap="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /></svg></div>
                    <div class="t-info">
                        <div class="t-hdr"><span class="t-clock">17:00</span><span class="t-name">Evening Rush</span><span class="t-bdg bdg-avoid">Avoid</span></div>
                        <div class="t-desc">Peak evening rush, worst traffic</div>
                    </div>
                    <div class="t-right"><div class="t-dur"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>3h 45m</div><div class="t-save ts-r">△ Extra EGP 106</div></div>
                    <svg class="t-arr" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6" /></svg>
                </div>
                <div style="height:14px;"></div>
            </div>
        </div>

        <!-- SPLIT WITH PASSENGERS -->
        <div class="sc" style="animation-delay:.2s;">
            <div class="sh" onclick="toggleSec(this)">
                <div class="sh-left">
                    <div class="sico" style="background:#ECFDF5;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" /></svg>
                    </div>
                    <div>
                        <div class="s-title">Split with Passengers</div>
                        <div class="s-sub">Add passengers to split costs</div>
                    </div>
                </div>
                <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9" /></svg>
            </div>
            <div class="sb" style="max-height:0;">
                <div class="split-inner">
                    <div class="si-hdr">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" /></svg>
                        <span>Split with Passengers</span>
                    </div>
                    <div class="sp-form">
                        <input class="sp-inp" id="pass-name-input" type="text" placeholder="Passenger name" onkeydown="if(event.key==='Enter')addPassenger()" />
                        <button class="add-btn" onclick="addPassenger()">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                        </button>
                    </div>
                    <div class="sp-empty" id="sp-empty">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" /></svg>
                        <p>Add passengers to split the trip cost</p>
                    </div>
                    <div class="pass-list" id="pass-list"></div>
                    <div class="sp-summary" id="sp-summary">
                        <p>Each person pays <strong id="sp-amount">EGP 176</strong></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- SMART INSIGHTS -->
        <div class="sc" style="animation-delay:.25s;">
            <div class="sh" onclick="toggleSec(this)">
                <div class="sh-left">
                    <div class="sico" style="background:#FFF7ED;">
