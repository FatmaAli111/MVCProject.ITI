@using MVCProject.ITI.ViewModels
@model CompletionTripViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Trip Summary";
}

<div class="topbar">
    @* <a href="@Url.Action("History", "Trip")" style="text-decoration:none; color:black; font-size:30px;">←</a> *@
    <div style="text-align: center;">
        <h3 style="margin:0; font-size: 26px; font-weight: 800;">Trip Summary</h3>
        <small style="color: var(--muted); font-size: 18px;">@Model.FromName To @Model.ToName</small>
    </div>
    <button onclick="openMapPopup()" style="background:var(--teal); color:white; border:none; padding:12px 25px; border-radius:12px; cursor:pointer; font-weight:700;">
        📍 View Route on Map
    </button>
</div>

<div class="page-container">
    <div class="hero-banner">
        <span style="text-transform: uppercase; font-size: 14px; font-weight: 800; opacity: 0.9;">Total Estimated Cost</span>
        <div class="amount">EGP @Model.TotalCost.ToString("N0")</div>
        <div style="background: rgba(255,255,255,0.2); padding: 12px 24px; border-radius: 12px; display: inline-block;">
            <b style="font-size: 20px;">🚗 @Model.CarName</b>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-box">
            <b>@Model.DistanceKm.ToString("F1")</b>
            <span>Distance (KM)</span>
        </div>
        <div class="stat-box">
            <b>@Model.DurationMinutes</b>
            <span>Duration (Min)</span>
        </div>
        <div class="stat-box">
            <b>@Model.FuelConsumed.ToString("F1")</b>
            <span>Fuel (Liters)</span>
        </div>
        <div class="stat-box">
            <b>@Model.CO2Kg</b>
            <span>CO2 (Kg)</span>
        </div>
    </div>

    <div class="detail-card">
        <h4 style="margin:0 0 25px 0; font-size: 26px;">Trip Details</h4>
        <div class="split-grid">
            <div class="info-item">
                <small style="color:var(--muted); font-weight:700;">TRAFFIC STATUS</small>
                <div style="margin-top:15px; font-weight:900; font-size: 24px; color:var(--orange);">@Model.TrafficCondition</div>
                <div style="height:12px; background:#E5E7EB; border-radius:10px; margin-top:20px; overflow:hidden;">
                    @{
                        string barWidth = "30%";
                        string barColor = "#4ADE80";
                        if (Model.TrafficCondition == "Heavy") { barWidth = "95%"; barColor = "#EF4444"; }
                        else if (Model.TrafficCondition == "Medium") { barWidth = "65%"; barColor = "#F59E0B"; }
                    }
                    <div style="background:@barColor; width: @barWidth; height:100%; transition: width 1s ease-in-out;"></div>
                </div>
            </div>
            <div class="info-item">
                <small style="color:var(--muted); font-weight:700;">COST BREAKDOWN</small>
                <div style="margin-top:20px; font-size:20px;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:12px;">
                        <span>Fuel Cost</span><b>EGP @Model.FuelCost.ToString("N0")</b>
                    </div>
                    <div style="display:flex; justify-content:space-between;">
                        <span>Maintenance</span><b>EGP @Model.MaintenanceCost.ToString("N0")</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="split-container">
        <div class="split-header" onclick="toggleSplit()">
            <div>
                <div class="split-title">Split with Passengers</div>
                <div class="split-sub">Add passengers to split costs</div>
            </div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" stroke="gray" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9" />
            </svg>
        </div>

        <div class="sb">
            <div class="split-inner" onclick="event.stopPropagation()">
                <div class="sp-top-row">
                    <span class="sp-mode-btn active" onclick="setSplitMode('equal',this)">Equal Split</span>
                    <span class="sp-mode-btn" onclick="setSplitMode('custom',this)">Custom %</span>
                </div>

                <div class="sp-form">
                    <input class="sp-inp" id="pass-name-input" placeholder="Passenger name" />
                    <button class="add-btn" onclick="addPassenger()">
                        <svg viewBox="0 0 24 24" width="20" stroke="white" stroke-width="2.5">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                    </button>
                </div>

                <div class="driver-row">
                    <div class="pi-left">
                        <div class="p-av">Y</div>
                        <div>
                            <div class="p-name">You (Driver)</div>
                        </div>
                    </div>
                    <div class="p-share-info">
                        <div class="p-share-amt" id="driver-amount">EGP @Model.TotalCost.ToString("F2")</div>
                        <div class="p-share-pct" id="driver-pct">100%</div>
                    </div>
                </div>
                <div id="pass-list"></div>

                <div class="sp-summary" id="sp-summary" style="display:none;">
                    <div class="sp-sum-row teal">
                        <span>You'll Collect</span>
                        <span>EGP <strong id="sp-collect">0</strong></span>
                    </div>
                </div>

                <div class="sp-actions" id="sp-actions" style="display:none;">
                    <button class="sp-Save-btn" onclick="saveSplit()">💾 Save Split</button>
                    <button class="sp-copy-btn" onclick="copySplit()">📋 Copy</button>
                    <button class="sp-share-btn" onclick="shareSplit()">📤 Share</button>
                </div>


            </div>
        </div>
    </div>


    <a href="@Url.Action("StartNewTrip", "Trip")" class="plan-btn">⚡ Plan Another Trip</a>
</div>

<div id="mapPopup">
    <div class="popup-content">
        <div class="close-map" onclick="closeMapPopup()">✕</div>
        <iframe id="mapFrame" width="100%" height="100%" frameborder="0" style="border:0" allowfullscreen></iframe>
    </div>
</div>

<script>
    const totalCost = @Model.TotalCost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    let passengers = [];
    let splitMode = 'equal'; // 'equal' or 'custom'

    function openMapPopup() {
        const fromCity = encodeURIComponent("@Model.FromName");
        const toCity = encodeURIComponent("@Model.ToName");

        const embedUrl = `https://www.google.com/maps?saddr=${fromCity},Egypt&daddr=${toCity},Egypt&output=embed`;

        document.getElementById('mapFrame').src = embedUrl;
        document.getElementById('mapPopup').style.display = 'flex';
    }

    function closeMapPopup() {
        document.getElementById('mapPopup').style.display = 'none';
        document.getElementById('mapFrame').src = '';
    }

    // Toggle split section
    function toggleSplit() {
        const box = document.querySelector(".sb");
        const chev = document.querySelector(".chev");

        box.classList.toggle("open");
        chev.classList.toggle("rotated");
    }

    // Set split mode (equal or custom)
    function setSplitMode(mode, element) {
        splitMode = mode;
        document.querySelectorAll('.sp-mode-btn').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');

        if (passengers.length > 0) {
            calculateSplit();
        }
    }

    // Add passenger
    function addPassenger() {
        const input = document.getElementById("pass-name-input");
        const name = input.value.trim();
        if (name === "") {
            alert("Please enter a passenger name");
            return;
        }

        // Check if passenger already exists
        if (passengers.find(p => p.name.toLowerCase() === name.toLowerCase())) {
            alert("Passenger already added");
            return;
        }

        passengers.push({
            id: '',
            name: name,
            shareAmount: 0,
            sharePercentage: 0
        });

        input.value = "";
        calculateSplit();
        showSummary();
    }

    // Calculate split based on mode
    function calculateSplit() {
        if (passengers.length === 0) {
            updateDriverShare(totalCost, 100);
            return;
        }

        if (splitMode === 'equal') {
            // Equal split among passengers
            const costPerPassenger = totalCost / (passengers.length + 1);
            const percentPerPassenger = 100 / (passengers.length + 1);

            passengers.forEach(p => {
                p.shareAmount = parseFloat(costPerPassenger.toFixed(2));
                p.sharePercentage = parseFloat(percentPerPassenger.toFixed(2));
            });

            updateDriverShare(costPerPassenger, percentPerPassenger);
        } else if (splitMode === 'custom') {
            // Custom percentage split - user will adjust
            let totalAllocated = passengers.reduce((sum, p) => sum + p.sharePercentage, 0);
            let remainingPercentage = 100 - totalAllocated;

            // If percentages are not set, start with equal
            if (totalAllocated === 0) {
                const percentPerPassenger = 100 / (passengers.length + 1);
                passengers.forEach(p => {
                    p.sharePercentage = parseFloat(percentPerPassenger.toFixed(2));
                    p.shareAmount = parseFloat((totalCost * p.sharePercentage / 100).toFixed(2));
                });
                updateDriverShare(
                    parseFloat((totalCost * percentPerPassenger / 100).toFixed(2)),
                    percentPerPassenger
                );
            } else {
                // Recalculate amounts based on percentages
                passengers.forEach(p => {
                    p.shareAmount = parseFloat((totalCost * p.sharePercentage / 100).toFixed(2));
                });
                updateDriverShare(
                    parseFloat((totalCost * remainingPercentage / 100).toFixed(2)),
                    remainingPercentage
                );
            }
        }

        renderPassengers();
    }

    // Update driver share display
    function updateDriverShare(amount, percentage) {
        document.getElementById('driver-amount').textContent = `EGP ${amount.toFixed(2)}`;
        document.getElementById('driver-pct').textContent = `${percentage.toFixed(2)}%`;

        // Calculate total amount passengers will pay
        const totalPassengerPayment = passengers.reduce((sum, p) => sum + p.shareAmount, 0);
        document.getElementById('sp-collect').textContent = totalPassengerPayment.toFixed(2);
    }

    // Render passengers list
    function renderPassengers() {
        const list = document.getElementById("pass-list");
        list.innerHTML = "";

        passengers.forEach((p, index) => {
            if (splitMode === 'custom') {
                list.innerHTML += `
                    <div class="passenger-card" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #E5E7EB;">
                        <div style="flex: 1;">
                            <strong>${p.name}</strong>
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <input type="number" min="0" max="100" value="${p.sharePercentage}" 
                                placeholder="%" style="width: 60px; padding: 6px; border: 1px solid #ccc; border-radius: 4px;"
                                onchange="updatePassengerPercentage(${index}, this.value)">
                            <span style="width: 100px; text-align: right;">EGP ${p.shareAmount.toFixed(2)}</span>
                            <button onclick="removePassenger(${index})" style="background: #EF4444; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer;">✕</button>
                        </div>
                    </div>
                `;
            } else {
                list.innerHTML += `
                    <div class="passenger-card" style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #E5E7EB;">
                        <div style="flex: 1;">
                            <strong>${p.name}</strong>
                        </div>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <span style="width: 100px; text-align: right;">EGP ${p.shareAmount.toFixed(2)} (${p.sharePercentage.toFixed(2)}%)</span>
                            <button onclick="removePassenger(${index})" style="background: #EF4444; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer;">✕</button>
                        </div>
                    </div>
                `;
            }
        });
    }

    // Update passenger percentage (for custom mode)
    function updatePassengerPercentage(index, percentage) {
        const pct = parseFloat(percentage) || 0;
        if (pct < 0 || pct > 100) {
            alert("Please enter a percentage between 0 and 100");
            return;
        }

        passengers[index].sharePercentage = parseFloat(pct.toFixed(2));
        passengers[index].shareAmount = parseFloat((totalCost * pct / 100).toFixed(2));

        // Recalculate driver share
        const totalPassengerPercentage = passengers.reduce((sum, p) => sum + p.sharePercentage, 0);
        const driverPercentage = 100 - totalPassengerPercentage;

        if (driverPercentage < 0) {
            alert("Passenger percentages cannot exceed 100%");
            passengers[index].sharePercentage = 0;
            passengers[index].shareAmount = 0;
            return;
        }

        updateDriverShare(
            parseFloat((totalCost * driverPercentage / 100).toFixed(2)),
            driverPercentage
        );
        renderPassengers();
    }

    // Remove passenger
    function removePassenger(index) {
        passengers.splice(index, 1);
        if (passengers.length === 0) {
            document.getElementById('sp-summary').style.display = 'none';
            document.getElementById('sp-actions').style.display = 'none';
            updateDriverShare(totalCost, 100);
            renderPassengers();
        } else {
            calculateSplit();
            showSummary();
        }
    }

    // Show summary and actions
    function showSummary() {
        if (passengers.length > 0) {
            document.getElementById('sp-summary').style.display = 'block';
            document.getElementById('sp-actions').style.display = 'block';
        }
    }

    // Save split to database
    function saveSplit() {
        if (passengers.length === 0) {
            alert("Please add at least one passenger");
            return;
        }

        const payload = {
            tripId: "@Model.TripId",
            passengers: passengers.map(p => ({
                id: p.id || '00000000-0000-0000-0000-000000000000',
                name: p.name,
                shareAmount: p.shareAmount,
                sharePercentage: p.sharePercentage
            }))
        };

        fetch('/Trip/SaveSplit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert("Split saved successfully!");
            } else {
                alert("Error saving split: " + (data.message || "Unknown error"));
            }
        })
        .catch(err => {
            console.error('Error:', err);
            alert("Error saving split");
        });
    }

    // Copy split to clipboard
    function copySplit() {
        const text = passengers.map(p => `${p.name}: EGP ${p.shareAmount.toFixed(2)} (${p.sharePercentage.toFixed(2)}%)`).join('\n');
        navigator.clipboard.writeText(text).then(() => {
            alert("Split copied to clipboard!");
        });
    }

    // Share split
    function shareSplit() {
        if (navigator.share) {
            const text = passengers.map(p => `${p.name}: EGP ${p.shareAmount.toFixed(2)}`).join('\n');
            navigator.share({
                title: "Trip Split",
                text: text
            });
        } else {
            alert("Share not supported on this device");
        }
    }
</script>

