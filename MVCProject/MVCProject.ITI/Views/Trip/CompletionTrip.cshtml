@using MVCProject.ITI.ViewModels
@model CompletionTripViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Trip Summary";
}

<style>
    :root {
        --teal: #0D9488;
        --teal-dk: #0a7a70;
        --teal-lt: #E6FAF8;
        --teal-bg: #F0FDFA;
        --bg: #F1F5F4;
        --white: #fff;
        --text: #111827;
        --soft: #4B6360;
        --muted: #9CA3AF;
        --border: #C7E0DC;
        --border-lt: #DFF0ED;
        --red: #EF4444;
        --red-lt: #FEF2F2;
        --green: #10B981;
        --green-lt: #ECFDF5;
        --orange: #F97316;
        --orange-lt: #FFF7ED;
        --purple: #8B5CF6;
        --purple-lt: #F5F3FF;
        --blue: #3B82F6;
        --blue-lt: #EFF6FF;
        --yellow: #F59E0B;
        --sh: 0 2px 12px rgba(13,148,136,.07);
        --sh-md: 0 4px 20px rgba(13,148,136,.12);
        --sh-lg: 0 8px 36px rgba(13,148,136,.17);
        --r: 16px;
        --r-sm: 10px;
        --pill: 999px;
    }

    body {
        font-family: 'DM Sans',sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        overflow-x: hidden;
    }

    .page-scroll {
        flex: 1;
        overflow-y: auto;
        padding-bottom: 28px;
        padding-top: 14px;
    }

    /* HERO CARD */
    .hero-card {
        background: linear-gradient(140deg,#0f9e92 0%,#0a6e65 100%);
        margin: 0 14px 0;
        border-radius: var(--r);
        padding: 22px 20px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: var(--sh-lg);
    }

        .hero-card::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

        .hero-card::after {
            content: '';
            position: absolute;
            bottom: -30px;
            left: 30px;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,.04);
        }

    .hc-label {
        font-size: 11px;
        font-weight: 700;
        opacity: .8;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .hc-amount {
        font-size: 44px;
        font-weight: 900;
        letter-spacing: -2px;
        margin: 5px 0 18px;
        line-height: 1;
    }

    .hc-row {
        display: flex;
        align-items: center;
        gap: 10px;
        position: relative;
        z-index: 1;
    }

    .plan-btn {
        flex: 1;
        background: rgba(255,255,255,.18);
        backdrop-filter: blur(4px);
        border: 1.5px solid rgba(255,255,255,.38);
        color: #fff;
        font-family: 'DM Sans',sans-serif;
        font-size: 14px;
        font-weight: 700;
        padding: 13px 18px;
        border-radius: var(--pill);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all .25s;
        text-decoration: none;
    }

        .plan-btn:hover {
            background: rgba(255,255,255,.28);
            transform: translateY(-1px);
        }

    .map-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255,255,255,.18);
        border: 1.5px solid rgba(255,255,255,.38);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: all .2s;
        color: #fff;
    }

        .map-btn:hover {
            background: rgba(255,255,255,.3);
        }

        .map-btn svg {
            width: 20px;
            height: 20px;
        }

    /* Trip route pill in hero */
    .hc-route {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
        border-radius: var(--pill);
        padding: 5px 14px;
        margin-bottom: 12px;
        font-size: 13px;
        font-weight: 600;
        opacity: .9;
    }

    .car-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,.2);
        position: relative;
        z-index: 1;
    }

    .car-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .car-av {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
    }

    .car-name {
        font-size: 14px;
        font-weight: 800;
    }

    .car-sub {
        font-size: 11px;
        opacity: .72;
        font-weight: 500;
    }

    .verified {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        font-weight: 700;
        opacity: .9;
    }

    /* STATS */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 10px;
        margin: 12px 14px;
        animation: slideUp .4s ease;
    }

    .stat-card {
        background: var(--white);
        border-radius: 12px;
        padding: 18px 10px 14px;
        text-align: center;
        box-shadow: var(--sh);
        transition: transform .2s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
        }

    .si {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        background: var(--teal-lt);
    }

        .si svg {
            width: 24px;
            height: 24px;
            stroke: var(--teal-dk);
        }

    .sv {
        font-size: 17px;
        font-weight: 900;
        letter-spacing: -.4px;
    }

    .sl {
        font-size: 10px;
        color: var(--muted);
        margin-top: 3px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    /* SECTION CARDS */
    .sc {
        background: var(--white);
        border-radius: var(--r);
        margin: 0 14px 12px;
        overflow: hidden;
        box-shadow: var(--sh);
        animation: slideUp .45s ease both;
    }

    .sh {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 18px;
        cursor: pointer;
        user-select: none;
        transition: background .15s;
    }

        .sh:hover {
            background: var(--teal-bg);
        }

    .sh-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sico {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--teal-lt);
    }

        .sico svg {
            width: 22px;
            height: 22px;
            stroke: var(--teal-dk);
        }

    .s-title {
        font-size: 15px;
        font-weight: 800;
        letter-spacing: -.2px;
    }

    .s-sub {
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
        font-weight: 500;
    }

    .chev {
        transition: transform .3s;
    }

        .chev.open {
            transform: rotate(180deg);
        }

    .sb {
        overflow: hidden;
        transition: max-height .38s cubic-bezier(.4,0,.2,1);
        max-height: 0;
    }

        .sb.open {
            max-height: 1000px;
        }

    /* TRAFFIC BAR */
    .traffic-bar {
        height: 12px;
        background: #E5E7EB;
        border-radius: 10px;
        margin-top: 20px;
        overflow: hidden;
    }

    .traffic-fill {
        height: 100%;
        transition: width 1s ease-in-out;
    }

    /* COST BREAKDOWN */
    .cost-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 15px;
    }

        .cost-item span {
            font-weight: 600;
            color: var(--soft);
        }

        .cost-item b {
            font-weight: 800;
            color: var(--text);
        }

    /* SPLIT SECTION */
    .split-inner {
        margin: 0 18px 20px;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    .sp-form {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
    }

    .sp-inp {
        flex: 1;
        padding: 12px 15px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-size: 14px;
        font-family: 'DM Sans',sans-serif;
        font-weight: 600;
        color: var(--text);
        background: var(--white);
        outline: none;
        transition: border-color .2s;
    }

        .sp-inp:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(13,148,136,.12);
        }

        .sp-inp::placeholder {
            color: var(--muted);
            font-weight: 500;
        }

    .add-btn {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--teal);
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all .2s;
    }

        .add-btn:hover {
            background: var(--teal-dk);
            transform: scale(1.07);
        }

        .add-btn svg {
            width: 21px;
            height: 21px;
            stroke: white;
        }

    .sp-mode-btn {
        background: var(--white);
        border: 1.5px solid var(--border);
        color: var(--text);
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s;
        margin: 8px 8px 8px 0;
    }

        .sp-mode-btn.active {
            background: var(--teal);
            color: #fff;
            border-color: var(--teal);
        }

    .driver-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid var(--border-lt);
        background: var(--white);
    }

    .pi-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .p-av {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--teal-lt);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: var(--teal-dk);
    }

    .p-name {
        font-size: 14px;
        font-weight: 800;
    }

    .p-share {
        font-size: 12px;
        color: var(--teal-dk);
        font-weight: 700;
        margin-top: 1px;
    }

    .p-share-info {
        text-align: right;
    }

    .p-share-amt {
        font-size: 14px;
        font-weight: 800;
        color: var(--text);
    }

    .p-share-pct {
        font-size: 12px;
        color: var(--muted);
        font-weight: 700;
        margin-top: 2px;
    }

    .pass-list {
        padding: 0 16px 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .passenger-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 14px;
        background: var(--white);
        border: 1.5px solid var(--border-lt);
        border-radius: 10px;
        animation: slideUp .25s ease;
    }

        .passenger-card input {
            width: 60px;
            padding: 6px;
            border: 1.5px solid var(--border);
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
        }

        .passenger-card button {
            background: var(--red);
            color: #fff;
            border: none;
            padding: 4px 8px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 700;
            transition: all .2s;
        }

            .passenger-card button:hover {
                background: #c53030;
                transform: scale(1.05);
            }

    .sp-summary {
        padding: 13px 16px;
        border-top: 1px solid var(--border-lt);
        background: var(--teal-bg);
    }

    .sp-sum-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
    }

        .sp-sum-row span {
            color: var(--soft);
        }

        .sp-sum-row strong {
            color: var(--teal-dk);
            font-size: 16px;
        }

    .sp-actions {
        display: flex;
        gap: 8px;
        padding: 14px 16px;
    }

    .sp-Save-btn, .sp-copy-btn, .sp-share-btn {
        flex: 1;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-family: 'DM Sans',sans-serif;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s;
        font-size: 14px;
    }

    .sp-Save-btn {
        background: var(--teal);
        color: #fff;
    }

        .sp-Save-btn:hover {
            background: var(--teal-dk);
        }

    .sp-copy-btn {
        background: var(--blue-lt);
        color: var(--blue);
        border: 1.5px solid var(--blue);
    }

        .sp-copy-btn:hover {
            background: var(--blue);
            color: #fff;
        }

    .sp-share-btn {
        background: var(--purple-lt);
        color: var(--purple);
        border: 1.5px solid var(--purple);
    }

        .sp-share-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    /* MAP MODAL */
    .mapPopup {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(10,35,33,.5);
        backdrop-filter: blur(7px);
        display: none;
        align-items: center;
        justify-content: center;
    }

        .mapPopup.open {
            display: flex;
        }

    .popup-content {
        background: var(--white);
        border-radius: 20px;
        width: 92%;
        max-width: 680px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,.28);
        position: relative;
        height: 500px;
    }

    .close-map {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 30px;
        height: 30px;
        background: var(--bg);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        z-index: 10;
        transition: all .2s;
    }

        .close-map:hover {
            background: var(--red-lt);
            color: var(--red);
        }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }
</style>

<div class="page-scroll">

    <!-- HERO CARD -->
    <div class="hero-card">
        <div class="hc-route">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="10" r="3" /><path d="M12 2a8 8 0 018 8c0 6-8 14-8 14S4 16 4 10a8 8 0 018-8z" /></svg>
            @Model.FromName → @Model.ToName
        </div>
        <span class="hc-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2zm1 14H11V11h2v5zm0-7H11V7h2v2z" /></svg>
            Total Estimated Cost
        </span>
        <div class="hc-amount">EGP @Model.TotalCost.ToString("N0")</div>
        <div class="hc-row">
            <button class="plan-btn" onclick="document.location='@Url.Action("StartNewTrip", "Trip")'">
                ⚡ Plan Another Trip
            </button>
            <button class="map-btn" onclick="openMapPopup()" title="View on Map">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /><line x1="8" y1="2" x2="8" y2="18" /><line x1="16" y1="6" x2="16" y2="22" /></svg>
            </button>
        </div>
        <div class="car-row">
            <div class="car-info">
                <div class="car-av">🚗</div>
                <div>
                    <div class="car-name">@Model.CarName</div>
                    <div class="car-sub">Trip Vehicle</div>
                </div>
            </div>
            <div class="verified">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" /></svg>
                Completed
            </div>
        </div>
    </div>

    <!-- STATS ROW -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="si">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="1" /><path d="M19.07 4.93l-2.12 2.12M7.05 16.95l-2.12 2.12M20 12a8 8 0 11-16 0 8 8 0 0116 0z" /></svg>
            </div>
            <div class="sv">@Model.DistanceKm.ToString("F1")</div>
            <div class="sl">Distance (KM)</div>
        </div>
        <div class="stat-card">
            <div class="si">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="1" /><polyline points="12 7 12 12 16 14" /><circle cx="12" cy="12" r="9" /></svg>
            </div>
            <div class="sv">@Model.DurationMinutes</div>
            <div class="sl">Duration (Min)</div>
        </div>
        <div class="stat-card">
            <div class="si">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M6 12c0-1.1.9-2 2-2s2 .9 2 2-1.8 2-2 4-1.5 2-2 4" /><path d="M14 12c0-1.1.9-2 2-2s2 .9 2 2-1.8 2-2 4-1.5 2-2 4" /></svg>
            </div>
            <div class="sv">@Model.FuelConsumed.ToString("F1")</div>
            <div class="sl">Fuel (Liters)</div>
        </div>
        <div class="stat-card">
            <div class="si">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M6 9c0-.55.45-1 1-1h10c.55 0 1 .45 1 1v10c0 .55-.45 1-1 1H7c-.55 0-1-.45-1-1V9z" /></svg>
            </div>
            <div class="sv">@Model.CO2Kg</div>
            <div class="sl">CO2 (Kg)</div>
        </div>
    </div>

    <!-- TRIP DETAILS SECTION -->
    <div class="sc">
        <div class="sh" onclick="toggleDetail(this)">
            <div class="sh-left">
                <div class="sico">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="9" y1="9" x2="15" y2="9" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                </div>
                <div>
                    <div class="s-title">Trip Details</div>
                    <div class="s-sub">Traffic & Cost Information</div>
                </div>
            </div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" stroke="var(--muted)" stroke-width="2.5" fill="none"><polyline points="6 9 12 15 18 9" /></svg>
        </div>
        <div class="sb">
            <div style="padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:24px;">
                <div>
                    <small style="color:var(--muted);font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.5px;">Traffic Status</small>
                    <div style="margin-top:15px;font-weight:900;font-size:24px;color:var(--orange);">@Model.TrafficCondition</div>
                    <div class="traffic-bar">
                        @{
                            string barWidth = "30%";
                            string barColor = "#4ADE80";
                            if (Model.TrafficCondition == "Heavy") { barWidth = "95%"; barColor = "#EF4444"; }
                            else if (Model.TrafficCondition == "Medium") { barWidth = "65%"; barColor = "#F59E0B"; }
                        }
                        <div class="traffic-fill" style="background:@barColor;width:@barWidth;"></div>
                    </div>
                </div>
                <div>
                    <small style="color:var(--muted);font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.5px;">Cost Breakdown</small>
                    <div style="margin-top:15px;">
                        <div class="cost-item">
                            <span>Fuel Cost</span>
                            <b>EGP @Model.FuelCost.ToString("N0")</b>
                        </div>
                        <div class="cost-item">
                            <span>Maintenance</span>
                            <b>EGP @Model.MaintenanceCost.ToString("N0")</b>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SPLIT WITH PASSENGERS SECTION -->
    <div class="sc">
        <div class="sh" onclick="toggleSplit(this)">
            <div class="sh-left">
                <div class="sico">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" /></svg>
                </div>
                <div>
                    <div class="s-title">Split with Passengers</div>
                    <div class="s-sub" id="split-subtitle">@(Model.HasSavedSplit ? "Saved cost split" : "Add passengers to split costs")</div>
                </div>
            </div>
            <svg class="chev" width="18" height="18" viewBox="0 0 24 24" stroke="var(--muted)" stroke-width="2.5" fill="none"><polyline points="6 9 12 15 18 9" /></svg>
        </div>
        <div class="sb @(Model.HasSavedSplit ? "open" : "")">
            <div class="split-inner" onclick="event.stopPropagation()">
                <div id="split-editor">
                <div style="padding:12px 16px;border-bottom:1px solid var(--border-lt);background:var(--white);">
                    <span class="sp-mode-btn active" onclick="setSplitMode('equal',this)">Equal Split</span>
                    <span class="sp-mode-btn" onclick="setSplitMode('custom',this)">Custom %</span>
                </div>
                <div class="sp-form">
                    <input class="sp-inp" id="pass-name-input" placeholder="Passenger name" />
                    <button class="add-btn" onclick="addPassenger()">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    </button>
                </div>
                <div class="driver-row">
                    <div class="pi-left">
                        <div class="p-av">Y</div>
                        <div>
                            <div class="p-name">You (Driver)</div>
                            <div class="p-share" id="driver-share">@Model.DriverSharePercent.ToString("F2")%</div>
                        </div>
                    </div>
                    <div class="p-share-info">
                        <div class="p-share-amt" id="driver-amount">EGP @Model.DriverShareAmount.ToString("F2")</div>
                    </div>
                </div>
                <div id="pass-list" class="pass-list"></div>
                <div class="sp-summary" id="sp-summary" style="display:none;">
                    <div class="sp-sum-row">
                        <span>You'll Collect</span>
                        <span>EGP <strong id="sp-collect">0</strong></span>
                    </div>
                </div>
                <div class="sp-actions" id="sp-actions" style="display:none;">
                    <button class="sp-Save-btn" onclick="saveSplit()">💾 Save Split</button>
                    <button class="sp-copy-btn" onclick="copySplit()">📋 Copy</button>
                    <button class="sp-share-btn" onclick="shareSplit()">📤 Share</button>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- MAP MODAL -->
<div id="mapPopup" class="mapPopup">
    <div class="popup-content">
        <button class="close-map" onclick="closeMapPopup()">✕</button>
        <iframe id="mapFrame" width="100%" height="100%" frameborder="0" style="border:0" allowfullscreen></iframe>
    </div>
</div>

<script>
    const totalCost = @Model.TotalCost.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    const hasSavedSplit = @(Model.HasSavedSplit.ToString().ToLower());
    const savedPassengers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Passengers));
    let passengers = [];
    let splitMode = 'equal';

    document.addEventListener('DOMContentLoaded', function () {
        if (!hasSavedSplit) return;
        const editor = document.getElementById('split-editor');
        if (editor) editor.style.display = 'none';
        const actions = document.getElementById('sp-actions');
        if (actions) actions.style.display = 'none';
        const splitBody = document.querySelector('.sc:last-of-type .sb');
        const splitChev = document.querySelector('.sc:last-of-type .chev');
        if (splitBody) splitBody.classList.add('open');
        if (splitChev) splitChev.classList.add('open');
        const summary = document.getElementById('sp-summary');
        if (summary) summary.style.display = 'block';
        const collect = document.getElementById('sp-collect');
        if (collect) collect.textContent = savedPassengers.reduce((s, p) => s + p.shareAmount, 0).toFixed(2);
        const list = document.getElementById('pass-list');
        if (list && savedPassengers.length) {
            list.innerHTML = savedPassengers.map(p =>
                `<div class="passenger-card saved-passenger"><div><strong>${p.name}</strong></div><div class="p-share-amt">EGP ${p.shareAmount.toFixed(2)} <span class="p-share-pct">(${p.sharePercentage.toFixed(2)}%)</span></div></div>`
            ).join('');
        }
    });

    function openMapPopup() {
        const fromCity = encodeURIComponent("@Model.FromName");
        const toCity = encodeURIComponent("@Model.ToName");
        const embedUrl = `https://www.google.com/maps?saddr=${fromCity},Egypt&daddr=${toCity},Egypt&output=embed`;
        document.getElementById('mapFrame').src = embedUrl;
        document.getElementById('mapPopup').classList.add('open');
    }

    function closeMapPopup() {
        document.getElementById('mapPopup').classList.remove('open');
        document.getElementById('mapFrame').src = '';
    }

    function toggleDetail(el) {
        const box = el.parentElement.querySelector(".sb");
        const chev = el.querySelector(".chev");
        box.classList.toggle("open");
        chev.classList.toggle("open");
    }

    function toggleSplit(el) {
        const box = el.parentElement.querySelector(".sb");
        const chev = el.querySelector(".chev");
        box.classList.toggle("open");
        chev.classList.toggle("open");
    }

    function setSplitMode(mode, element) {
        splitMode = mode;
        document.querySelectorAll('.sp-mode-btn').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
        if (passengers.length > 0) calculateSplit();
    }

    function addPassenger() {
        const input = document.getElementById("pass-name-input");
        const name = input.value.trim();
        if (name === "") { alert("Please enter a passenger name"); return; }
        if (passengers.find(p => p.name.toLowerCase() === name.toLowerCase())) { alert("Passenger already added"); return; }
        passengers.push({ id: '', name: name, shareAmount: 0, sharePercentage: 0 });
        input.value = "";
        calculateSplit();
        showSummary();
    }

    function calculateSplit() {
        if (passengers.length === 0) { updateDriverShare(totalCost, 100); return; }
        if (splitMode === 'equal') {
            const costPerPassenger = totalCost / (passengers.length + 1);
            const percentPerPassenger = 100 / (passengers.length + 1);
            passengers.forEach(p => {
                p.shareAmount = parseFloat(costPerPassenger.toFixed(2));
                p.sharePercentage = parseFloat(percentPerPassenger.toFixed(2));
            });
            updateDriverShare(costPerPassenger, percentPerPassenger);
        } else if (splitMode === 'custom') {
            let totalAllocated = passengers.reduce((sum, p) => sum + p.sharePercentage, 0);
            let remainingPercentage = 100 - totalAllocated;
            if (totalAllocated === 0) {
                const percentPerPassenger = 100 / (passengers.length + 1);
                passengers.forEach(p => {
                    p.sharePercentage = parseFloat(percentPerPassenger.toFixed(2));
                    p.shareAmount = parseFloat((totalCost * p.sharePercentage / 100).toFixed(2));
                });
                updateDriverShare(parseFloat((totalCost * percentPerPassenger / 100).toFixed(2)), percentPerPassenger);
            } else {
                passengers.forEach(p => { p.shareAmount = parseFloat((totalCost * p.sharePercentage / 100).toFixed(2)); });
                updateDriverShare(parseFloat((totalCost * remainingPercentage / 100).toFixed(2)), remainingPercentage);
            }
        }
        renderPassengers();
    }

    function updateDriverShare(amount, percentage) {
        document.getElementById('driver-amount').textContent = `EGP ${parseFloat(amount).toFixed(2)}`;
        document.getElementById('driver-share').textContent = `${parseFloat(percentage).toFixed(2)}%`;
        const totalPassengerPayment = passengers.reduce((sum, p) => sum + p.shareAmount, 0);
        document.getElementById('sp-collect').textContent = totalPassengerPayment.toFixed(2);
    }

    function renderPassengers() {
        const list = document.getElementById("pass-list");
        list.innerHTML = "";
        passengers.forEach((p, index) => {
            if (splitMode === 'custom') {
                list.innerHTML += `
                    <div class="passenger-card">
                        <div style="flex:1;"><strong>${p.name}</strong></div>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <input type="number" min="0" max="100" value="${p.sharePercentage}" placeholder="%" onchange="updatePassengerPercentage(${index}, this.value)">
                            <span style="width:100px;text-align:right;font-weight:700;">EGP ${p.shareAmount.toFixed(2)}</span>
                            <button onclick="removePassenger(${index})">✕</button>
                        </div>
                    </div>`;
            } else {
                list.innerHTML += `
                    <div class="passenger-card">
                        <div style="flex:1;"><strong>${p.name}</strong></div>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <span style="width:140px;text-align:right;font-weight:700;">EGP ${p.shareAmount.toFixed(2)} (${p.sharePercentage.toFixed(2)}%)</span>
                            <button onclick="removePassenger(${index})">✕</button>
                        </div>
                    </div>`;
            }
        });
    }

    function updatePassengerPercentage(index, percentage) {
        const pct = parseFloat(percentage) || 0;
        if (pct < 0 || pct > 100) { alert("Please enter a percentage between 0 and 100"); return; }
        passengers[index].sharePercentage = parseFloat(pct.toFixed(2));
        passengers[index].shareAmount = parseFloat((totalCost * pct / 100).toFixed(2));
        const totalPassengerPercentage = passengers.reduce((sum, p) => sum + p.sharePercentage, 0);
        const driverPercentage = 100 - totalPassengerPercentage;
        if (driverPercentage < 0) {
            alert("Passenger percentages cannot exceed 100%");
            passengers[index].sharePercentage = 0;
            passengers[index].shareAmount = 0;
            return;
        }
        updateDriverShare(parseFloat((totalCost * driverPercentage / 100).toFixed(2)), driverPercentage);
        renderPassengers();
    }

    function removePassenger(index) {
        passengers.splice(index, 1);
        if (passengers.length === 0) {
            document.getElementById('sp-summary').style.display = 'none';
            document.getElementById('sp-actions').style.display = 'none';
            updateDriverShare(totalCost, 100);
            renderPassengers();
        } else {
            calculateSplit();
            showSummary();
        }
    }

    function showSummary() {
        if (passengers.length > 0) {
            document.getElementById('sp-summary').style.display = 'block';
            document.getElementById('sp-actions').style.display = 'flex';
        }
    }

    function saveSplit() {
        if (passengers.length === 0) { alert("Please add at least one passenger"); return; }
        const payload = {
            tripId: "@Model.TripId",
            passengers: passengers.map(p => ({
                id: p.id || '00000000-0000-0000-0000-000000000000',
                name: p.name,
                shareAmount: p.shareAmount,
                sharePercentage: p.sharePercentage
            }))
        };
        fetch('/Trip/SaveSplit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) { window.location.reload(); }
            else alert("Error saving split: " + (data.message || "Unknown error"));
        })
        .catch(err => { console.error('Error:', err); alert("Error saving split"); });
    }

    function copySplit() {
        const text = passengers.map(p => `${p.name}: EGP ${p.shareAmount.toFixed(2)} (${p.sharePercentage.toFixed(2)}%)`).join('\n');
        navigator.clipboard.writeText(text).then(() => { alert("Split copied to clipboard!"); });
    }

    function shareSplit() {
        if (navigator.share) {
            const text = passengers.map(p => `${p.name}: EGP ${p.shareAmount.toFixed(2)}`).join('\n');
            navigator.share({ title: "Trip Split", text: text });
        } else {
            alert("Share not supported on this device");
        }
    }
</script>
