@using MVCProject.ITI.DataAccessLayer.Entities
@model IEnumerable<TripCardViewModel>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Trip History";
    int count = Model?.Count() ?? 0;
}



<h2 style="margin:10px; font-size:20px;">Trip History</h2>
<span style="background:#F3F4F6; padding:5px 12px; border-radius:20px; font-size:13px; font-weight:600; display:inline-block;  margin-bottom:10px;">
    @count trips
</span>
<div class="history-container">
    @if (count == 0)
    {
        <div style="text-align:center; padding:100px 0; color:#9CA3AF;"><p>No trips recorded yet.</p></div>
    }
    else
    {
            @foreach (var i in Model)
            {
                    <a href="@Url.Action("CompletionTrip", "Trip", new { id = i.Id })" style="text-decoration:none; color:inherit; display:flex; flex:1; align-items:center;">
                
                   
                        @Html.Partial("_RecentTripCardPartial", i)
                    
                </a>
                
        }
    }
</div>

@section Scripts {
    <script>
        async function toggleFavorite(btn, tripId) {
            try {
                const response = await fetch(`/Trip/ToggleFavorite?tripId=${tripId}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    btn.classList.toggle('active', result.isFavorite);
                    btn.querySelector('svg').setAttribute('fill', result.isFavorite ? 'currentColor' : 'none');
                }
            } catch (e) { console.error(e); }
        }

        async function deleteTrip(tripId) {
            if (!confirm("Are you sure?")) return;
            try {
                const response = await fetch(`/Trip/DeleteTrip/${tripId}`, { method: 'POST' });
                const data = await response.json();
                if (data.success) document.getElementById(`trip-${tripId}`).remove();
            } catch (e) { alert("Error occurred."); }
        }
    </script>
}