@{
    Layout = "~/Views/Trip/_TripLayout.cshtml";
    ViewData["Title"] = "Trip History";
}
<div class="page" id="page-history">
    <div class="topbar">
        <div class="tb-left">
            <button class="back-btn" onclick="showTrip()">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6" /></svg>
            </button>
            <div class="tb-title">
                <h2>Trip History</h2>
                <p>5 trips recorded</p>
            </div>
        </div>
        <div class="tb-acts">
            <button class="icon-btn icon-btn-ghost">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            </button>
        </div>
    </div>
    <div class="page-scroll">
        <div class="history-list" id="history-list"></div>
    </div>
</div>
