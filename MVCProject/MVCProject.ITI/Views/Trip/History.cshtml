@model PaginatedResult<TripCardViewModel>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Trip History";
    var count = Model.TotalCount;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Garage,analytics.css" asp-append-version="true" />
}

<div class="page-wrap history-page">
    <div class="garage-header">
        <div>
            <h1 class="page-title">Trip History</h1>
            <p class="page-sub">@count trip@(count != 1 ? "s" : "") recorded</p>
        </div>
        <a class="btn btn-teal" asp-controller="Trip" asp-action="StartNewTrip">
            <i class="bi bi-plus-lg"></i> New Trip
        </a>
    </div>

    @if (!Model.Data.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <h3 class="empty-title">No trips yet</h3>
            <p class="empty-sub">Start your first trip to see your route history and cost breakdowns here.</p>
            <a class="btn btn-teal" asp-controller="Trip" asp-action="StartNewTrip">
                <i class="bi bi-geo-alt-fill"></i> Plan a Trip
            </a>
        </div>
    }
    else
    {
        <div class="history-container">
            @foreach (var trip in Model.Data)
            {
                <a href="@Url.Action("CompletionTrip", "Trip", new { id = trip.Id })" class="history-trip-link">
                    <partial name="_RecentTripCardPartial" model="trip" />
                </a>
            }
        </div>
        @await Html.PartialAsync("_AppPagination", Model)
    }
</div>

@section Scripts {
    <script>
        async function toggleFavorite(btn, tripId) {
            try {
                const response = await fetch(`/Trip/ToggleFavorite?tripId=${tripId}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    btn.classList.toggle('active', result.isFavorite);
                    btn.querySelector('svg')?.setAttribute('fill', result.isFavorite ? 'currentColor' : 'none');
                }
            } catch (e) { console.error(e); }
        }

        async function deleteTrip(tripId) {
            if (!confirm('Delete this trip?')) return;
            try {
                const response = await fetch(`/Trip/DeleteTrip?id=${tripId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                });
                const result = await response.json();
                if (result.success) {
                    const link = document.getElementById(`trip-${tripId}`)?.closest('.history-trip-link');
                    if (link) link.remove();
                    else window.location.href = '@Url.Action("History", "Trip")';
                    if (!document.querySelector('.history-trip-link')) {
                        window.location.reload();
                    }
                } else {
                    alert(result.message || 'Could not delete trip.');
                }
            } catch (e) {
                console.error(e);
                alert('Could not delete trip.');
            }
        }
    </script>
}
