@using MVCProject.ITI.DataAccessLayer.Entities
@model IEnumerable<Trip>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Trip History";
    int count = Model?.Count() ?? 0;
}
<style>
    .history-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }

    .h-item {
        display: flex;
        align-items: center;
        background: white;
        padding: 20px;
        border-radius: 20px;
        margin-bottom: 15px;
        border: 1px solid #E5E7EB;
        text-decoration: none;
        color: inherit;
        transition: 0.3s;
        position: relative;
    }

        .h-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

    .h-av {
        width: 50px;
        height: 50px;
        background: #F0FDFA;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
    }

    .h-info {
        flex: 1;
    }

    .h-route {
        font-weight: 800;
        font-size: 16px;
        margin-bottom: 4px;
    }

    .h-meta {
        color: #6B7280;
        font-size: 13px;
        display: flex;
        gap: 10px;
    }

    .h-cost-box {
        text-align: right;
        margin-right: 15px;
    }

    .h-cost {
        font-weight: 900;
        font-size: 18px;
        color: #111827;
    }

    .del-btn {
        background: #FEE2E2;
        border: none;
        color: #EF4444;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        z-index: 10;
    }

        .del-btn:hover {
            background: #EF4444;
            color: white;
        }
</style>
<div class="topbar" style="background:white; padding:20px; border-bottom:1px solid #eee; display:flex; justify-content:space-between; align-items:center;">
    <h2 style="margin:0; font-size:20px;">Trip History</h2>
    <span style="background:#F3F4F6; padding:5px 12px; border-radius:20px; font-size:13px; font-weight:600;">@count trips</span>
</div>
<div class="history-container">
    @if (count == 0)
    {
        <div style="text-align:center; padding:100px 0; color:#9CA3AF;"><p>No trips recorded yet.</p></div>
    }
    else
    {
        @foreach (var t in Model)
        {
            <div class="h-item" id="trip-@t.Id">
                <a href="@Url.Action("CompletionTrip", "Trip", new { id = t.Id })" style="text-decoration:none; color:inherit; display:flex; flex:1; align-items:center;">
                    <div class="h-av">
                        <svg width="24" height="24" fill="none" stroke="#2DD4BF" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    </div>
                    <div class="h-info">
                        <div class="h-route">@t.OriginName → @t.DestinationName</div>
                        <div class="h-meta"><span>@t.TripDate.ToString("dd MMM")</span><span>•</span><span>@t.DistanceKm.ToString("F1") km</span></div>
                    </div>
                    <div class="h-cost-box">
                        <div class="h-cost">@((t.TripCostResult?.TotalCost ?? 0).ToString("N0"))</div>
                        <div style="font-size:10px; color:#6B7280;">EGP</div>
                    </div>
                </a>
                <button class="del-btn" onclick="deleteTrip('@t.Id')">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </button>
            </div>
        }
    }
</div>
<script>
    async function deleteTrip(tripId) {
        if (!confirm("Are you sure you want to delete this trip?")) return;
        try {
            const response = await fetch(`/Trip/DeleteTrip/${tripId}`, { method: 'POST' });
            const data = await response.json();
            if (data.success) {
                document.getElementById(`trip-${tripId}`).remove();
            } else {
                alert("Failed to delete trip.");
            }
        } catch (e) {
            alert("Error occurred.");
        }
    }
</script>