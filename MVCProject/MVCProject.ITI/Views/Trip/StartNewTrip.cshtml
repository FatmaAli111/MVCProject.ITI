@using MVCProject.ITI.ViewModels
@model NewTripViewModel
@{
    Layout = "_AppLayout";
}
@section Styles {
<link rel="stylesheet" href="~/css/NewTrip.css" />
}
<form asp-action="StartTrip" asp-controller="Trip" method="post">
    <div class="page">
        <div class="card">
            <div class="loc-label">From</div>
            <div class="location-row">
                <span class="loc-dot green"></span>
                <input class="loc-input" asp-for="From" placeholder="Starting location" autocomplete="off" />
                <span asp-validation-for="From" class="text-danger"></span>
            </div>
            <div class="loc-connector"><div class="loc-line"></div></div>
            <div class="loc-label">To</div>
            <div class="location-row">
                <span class="loc-dot red"></span>
                <input class="loc-input" asp-for="To" placeholder="Destination" autocomplete="off" />
                <span asp-validation-for="To" class="text-danger"></span>
            </div>
        </div>
        <div class="card">
            <div class="section-label">When do you want to leave?</div>
            <div class="toggle-row">
                <button type="button" class="toggle-btn active" id="btnLeaveNow" onclick="setLeaveNow()">
                    <i class="bi bi-clock"></i> Leave Now
                </button>
                <button type="button" class="toggle-btn" id="btnSchedule" onclick="setSchedule()">
                    <i class="bi bi-calendar3"></i> Schedule
                </button>
            </div>
            <input type="hidden" asp-for="LeaveNow" id="leaveNowInput" />
            <div class="schedule-input" id="scheduleInput">
                <input type="datetime-local" class="loc-input" asp-for="ScheduledTime" />
                <span asp-validation-for="ScheduledTime" class="text-danger"></span>
            </div>
        </div>
        <div class="card">
            <div class="vehicle-row" onclick="toggleVehicle()">
                <div class="vehicle-icon"><i class="bi bi-car-front-fill"></i></div>
                <div class="vehicle-info">
                    <div class="vehicle-name">Daily Driver</div>
                    @if (ViewBag.Vehicle != null)
                    {
                        <div class="vehicle-sub">@ViewBag.Vehicle.NickName • @ViewBag.Vehicle.CarModel.Model</div>
                    }
                    else
                    {
                        <div class="vehicle-sub">No Default Vehicle Selected</div>
                    }
                </div>
                @* <i class="bi bi-chevron-down chevron" id="vehicleChevron"></i> *@
            </div>
        </div>
        <div class="smart-card">
            <div class="smart-icon"><i class="bi bi-stars"></i></div>
            <div class="smart-info">
                <h4>Smart Trip Analysis</h4>
                <p>Get route comparison, best time to travel &amp; ride-share comparison</p>
            </div>
        </div>
        <div class="section-title">Popular Destinations</div>
        <div class="chips">
            @if (ViewData["AllTrips"]!=null)
            {
                @foreach (var i in (IEnumerable<TripCardViewModel>)ViewData["AllTrips"])
                {
                    <div class="chip" onclick="setDest(this)"><i class="bi bi-geo-alt-fill"></i><span>@i.DestinationName</span></div>

                }
            }
            else
            {
                    <h2 style="text-align:center">No Popular Distenation</h2>

            }
           
        </div>
    </div>
    <div class="compare-bar">
        <button type="submit" class="compare-btn">
            <i class="bi bi-arrow-left-right"></i> Start Trip
        </button>
    </div>
</form>
<script>
    function setLeaveNow() {
        document.getElementById('btnLeaveNow').classList.add('active');
        document.getElementById('btnSchedule').classList.remove('active');
        document.getElementById('scheduleInput').classList.remove('show');
        document.getElementById('leaveNowInput').value = 'true';
    }
    function setSchedule() {
        document.getElementById('btnSchedule').classList.add('active');
        document.getElementById('btnLeaveNow').classList.remove('active');
        document.getElementById('scheduleInput').classList.add('show');
        document.getElementById('leaveNowInput').value = 'false';
    }
    function toggleVehicle() {
        const ch = document.getElementById('vehicleChevron');
        ch.className = ch.className.includes('down') ? 'bi bi-chevron-up chevron' : 'bi bi-chevron-down chevron';
    }
    function setDest(el) {
        document.querySelectorAll('.loc-input')[1].value = el.querySelector('span').textContent;
    }

    // set default value on load
    document.getElementById('leaveNowInput').value = 'true';
</script>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}