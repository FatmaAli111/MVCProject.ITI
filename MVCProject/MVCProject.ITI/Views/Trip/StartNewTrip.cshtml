@using MVCProject.ITI.ViewModels
@model NewTripViewModel
@{
    Layout = "_AppLayout";
    if (Model == null) { return; }
}
@section Styles {
    <link rel="stylesheet" href="~/css/NewTrip.css" />
    <style>
        .form-select-custom {
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px;
            font-size: 0.95rem;
            transition: all 0.3s;
            background-color: #f8fafc;
        }
        .form-select-custom:focus {
            border-color: #2dd4bf;
            box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.1);
            outline: none;
        }
        .toggle-row {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }
        .toggle-btn {
            flex: 1;
            padding: 12px;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 500;
            color: #64748b;
        }
        .toggle-btn.active {
            background: #2dd4bf;
            border-color: #2dd4bf;
            color: white;
        }
        .scheduled-input-container {
            margin-top: 15px;
            animation: fadeIn 0.3s ease;
        }
        @("@")keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<div class="page">
    <form id="tripForm" onsubmit="handleSubmit(event)">
        <div class="card">
            <div class="loc-label">From</div>
            <div class="location-row">
                <span class="loc-dot green"></span>
                <input class="loc-input" id="fromInput" placeholder="Starting location" required />
            </div>
            <div class="loc-connector"><div class="loc-line"></div></div>
            <div class="loc-label">To</div>
            <div class="location-row">
                <span class="loc-dot red"></span>
                <input class="loc-input" id="toInput" placeholder="Destination" required />
            </div>
        </div>

        <div class="card">
            <div class="section-label">Departure Time</div>
            <div class="toggle-row">
                <button type="button" class="toggle-btn active" id="btnLeaveNow" onclick="setDeparture(true)">
                    <i class="bi bi-clock"></i> Leave Now
                </button>
                <button type="button" class="toggle-btn" id="btnSchedule" onclick="setDeparture(false)">
                    <i class="bi bi-calendar-event"></i> Schedule
                </button>
            </div>
            
            <input type="hidden" id="leaveNowInput" value="true" />
            
            <div id="scheduleContainer" class="scheduled-input-container" style="display:none;">
                <input type="datetime-local" id="scheduledTimeInput" class="form-control form-select-custom" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            </div>
        </div>

        <div class="card">
            <div class="section-label">Select Your Vehicle</div>
            <select id="vehicleIdInput" class="form-select-custom w-100" required>
                <option value="">-- Choose a vehicle from your garage --</option>
                @if (Model.AvailableVehicles != null)
                {
                    @foreach (var vehicle in Model.AvailableVehicles)
                    {
                        <option value="@vehicle.Value">@vehicle.Text</option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="submit-btn" id="submitBtn">Submit Trip</button>
        
        <div id="loadingSpinner" style="display:none; text-align:center; padding: 20px;">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Calculating your trip cost...</p>
        </div>
    </form>
</div>

<script>
    function setDeparture(isLeaveNow) {
        document.getElementById('leaveNowInput').value = isLeaveNow;
        
        const btnNow = document.getElementById('btnLeaveNow');
        const btnSched = document.getElementById('btnSchedule');
        const container = document.getElementById('scheduleContainer');

        if (isLeaveNow) {
            btnNow.classList.add('active');
            btnSched.classList.remove('active');
            container.style.display = 'none';
        } else {
            btnNow.classList.remove('active');
            btnSched.classList.add('active');
            container.style.display = 'block';
        }
    }

    async function submitTrip() {
        const from = document.getElementById('fromInput').value;
        const to = document.getElementById('toInput').value;
        const vehicleId = document.getElementById('vehicleIdInput').value;
        const leaveNow = document.getElementById('leaveNowInput').value === 'true';
        const scheduledTime = document.getElementById('scheduledTimeInput').value;

        if (!vehicleId) {
            alert("Please select a vehicle");
            return;
        }

        document.getElementById('submitBtn').style.display = 'none';
        document.getElementById('loadingSpinner').style.display = 'block';

        try {
            const response = await fetch('/Trip/StartTrip', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    from: from,
                    to: to,
                    vehicleId: vehicleId,
                    isAcOn: true,
                    leaveNow: leaveNow,
                    scheduledTime: scheduledTime
                })
            });

            const data = await response.json();
            if (data.success) {
                window.location.href = data.redirectUrl;
            } else {
                alert('Error: ' + data.message);
                resetUI();
            }
        } catch (error) {
            alert('An unexpected error occurred');
            resetUI();
        }
    }

    function resetUI() {
        document.getElementById('submitBtn').style.display = 'block';
        document.getElementById('loadingSpinner').style.display = 'none';
    }

    function handleSubmit(event) {
        event.preventDefault();
        submitTrip();
    }
</script>