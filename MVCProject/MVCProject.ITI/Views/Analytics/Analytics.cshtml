@using MVCProject.ITI.ViewModels
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    Layout = "_AppLayout";
}

<section class="analytics-header">
    <div>
        <h1 class="analytics-title">Analytics</h1>
        <p class="analytics-subtitle">Your travel insights</p>
    </div>
    <span class="time-pill">All Time</span>
</section>

<section class="row g-3">

    <!-- Total Distance -->
    <div class="col-lg-6">
        <div class="analytics-kpi">
            <span class="kpi-icon kpi-icon-teal">km</span>
            <div class="kpi-value">@Model.TotalDistance.ToString("0.00") km</div>
            <div class="kpi-label">Total Distance</div>
            <div class="kpi-sub">@Model.TripCount trips</div>
        </div>
    </div>

    <!-- Total Spent -->
    <div class="col-lg-6">
        <div class="analytics-kpi">
            <span class="kpi-icon kpi-icon-purple">$</span>
            <div class="kpi-value">EGP @Model.TotalSpent.ToString("0.00")</div>
            <div class="kpi-label">Total Spent</div>
            <div class="kpi-sub">
                Avg EGP @(Model.TripCount == 0 ? 0 : (Model.TotalSpent / Model.TripCount)) / trip
            </div>
        </div>
    </div>

    <!-- Fuel Cost -->
    <div class="col-lg-6">
        <div class="analytics-kpi">
            <span class="kpi-icon kpi-icon-amber">F</span>
            <div class="kpi-value">EGP @Model.FuelCost.ToString("0.00")</div>
            <div class="kpi-label">Fuel Cost</div>
            <div class="kpi-sub">@Model.FuelPercentage% of total</div>
        </div>
    </div>

    <!-- Emissions -->
    <div class="col-lg-6">
        <div class="analytics-kpi">
            <span class="kpi-icon kpi-icon-green">CO2</span>
            <div class="kpi-value">@Model.Emissions.ToString("0.00") kg</div>
            <div class="kpi-label">CO2 Emissions</div>
            <div class="kpi-sub">131 g/km</div>
        </div>
    </div>

</section>

<!-- Monthly Spending Chart -->
<section class="analytics-panel mt-3">
    <h3 class="panel-title">Monthly Spending</h3>

    <script>
            const monthlySpending = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySpending));
            console.log("Monthly Spending:", monthlySpending);
    </script>

    <div class="chart chart-line">
        <div class="chart-axis-y">
            <span>2800</span>
            <span>2100</span>
            <span>1400</span>
            <span>700</span>
        </div>
        <div class="chart-canvas">
            <div class="line-dot"></div>
        </div>
    </div>
</section>

<!-- Monthly Distance Chart -->
<section class="analytics-panel mt-3">
    <h3 class="panel-title">Distance Traveled</h3>

    <script>
            const monthlyDistance = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyDistance));
            console.log("Monthly Distance:", monthlyDistance);
    </script>

    <div class="chart chart-bar">
        <div class="chart-axis-y">
            <span>2000 km</span>
            <span>1500 km</span>
            <span>1000 km</span>
            <span>500 km</span>
        </div>
        <div class="chart-canvas">
            <div class="bar-fill"></div>
        </div>
    </div>
</section>

<!-- Cost Breakdown -->
<section class="analytics-panel mt-3">
    <h3 class="panel-title">Cost Breakdown</h3>
    <div class="breakdown-wrap">
        <div class="donut-chart"></div>
        <div class="breakdown-legend">
            <div class="legend-row"><span><i class="dot dot-fuel"></i>Fuel</span><strong>@Model.FuelPercentage%</strong></div>
            <div class="legend-row"><span><i class="dot dot-tolls"></i>Tolls</span><strong>@Model.TollsPercentage%</strong></div>
            <div class="legend-row"><span><i class="dot dot-maintenance"></i>Maintenance</span><strong>@Model.MaintenancePercentage%</strong></div>
        </div>
    </div>
</section>
