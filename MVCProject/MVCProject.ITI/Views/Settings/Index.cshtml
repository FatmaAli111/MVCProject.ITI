@model MVCProject.ITI.ViewModels.Settings.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    Layout = "_AppLayout";
}
@{
    Layout = "_AppLayout";
}
<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="text-center mb-5">
                <h1 class="fw-bold mb-3">Settings</h1>
                <p class="text-muted">Manage your Profile, Vehicle, and Preferences</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Profile Section -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-person-fill text-primary fs-4"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Profile</h5>
                    </div>

                    <form id="profileForm" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label for="FullName" class="form-label fw-semibold">Full Name</label>
                            <input type="text" class="form-control" id="FullName" name="FullName" 
                                   value="@Model.Profile.FullName" required>
                            <div class="invalid-feedback">Full name is required</div>
                        </div>

                        <div class="mb-3">
                            <label for="Email" class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control bg-light" id="Email" name="Email" 
                                   value="@Model.Profile.Email" readonly>
                            <small class="text-muted">Email cannot be changed</small>
                        </div>

                        <div class="mb-4">
                            <label for="PhoneNumber" class="form-label fw-semibold">Phone Number <span class="text-muted">(Optional)</span></label>
                            <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber" 
                                   value="@Model.Profile.PhoneNumber">
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check-lg me-2"></i>Save Profile
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Vehicle Info Section -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-car-front-fill text-success fs-4"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Vehicle Info</h5>
                    </div>

                    @if (Model.VehicleInfo != null)
                    {
                        <form id="vehicleForm" class="needs-validation" novalidate>
                            <input type="hidden" id="VehicleId" name="VehicleId" value="@Model.VehicleInfo.VehicleId" />
                            
                            <div class="mb-3">
                                <label for="Make" class="form-label fw-semibold">Make</label>
                                <select class="form-select" id="Make" name="Make" required>
                                    <option value="">Select Make</option>
                                    @foreach (var make in Model.VehicleInfo.AvailableMakes)
                                    {
                                        if (make == Model.VehicleInfo.Make)
                                        {
                                            <option value="@make" selected>@make</option>
                                        }
                                        else
                                        {
                                            <option value="@make">@make</option>
                                        }
                                    }
                                </select>
                                <div class="invalid-feedback">Please select a make</div>
                            </div>

                            <div class="mb-3">
                                <label for="Model" class="form-label fw-semibold">Model</label>
                                <select class="form-select" id="Model" name="Model" required>
                                    <option value="">Select Model</option>
                                    @foreach (var modelItem in Model.VehicleInfo.AvailableModels)
                                    {
                                        if (modelItem == Model.VehicleInfo.Model)
                                        {
                                            <option value="@modelItem" selected>@modelItem</option>
                                        }
                                        else
                                        {
                                            <option value="@modelItem">@modelItem</option>
                                        }
                                    }
                                </select>
                                <div class="invalid-feedback">Please select a model</div>
                            </div>

                            <div class="mb-3">
                                <label for="Year" class="form-label fw-semibold">Year</label>
                                <select class="form-select" id="Year" name="Year" required>
                                    <option value="">Select Year</option>
                                    @foreach (var year in Model.VehicleInfo.AvailableYears)
                                    {
                                        if (year == Model.VehicleInfo.Year)
                                        {
                                            <option value="@year" selected>@year</option>
                                        }
                                        else
                                        {
                                            <option value="@year">@year</option>
                                        }
                                    }
                                </select>
                                <div class="invalid-feedback">Please select a year</div>
                            </div>

                            <div class="mb-3">
                                <label for="WltpMixed" class="form-label fw-semibold">
                                    Mixed (L/100km)
                                    <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" 
                                       title="WLTP Combined fuel consumption"></i>
                                </label>
                                <div class="input-group">
                                    <input type="number" class="form-control" id="WltpMixed" name="WltpMixed" 
                                           step="0.1" value="@Model.VehicleInfo.WltpMixed" readonly>
                                    <button type="button" class="btn btn-outline-secondary" id="overrideBtn" 
                                            data-bs-toggle="tooltip" title="Allow manual editing">
                                        <i class="bi bi-pencil"></i> Override
                                    </button>
                                </div>
                                <small class="text-muted">Auto-filled from database</small>
                            </div>

                            <div class="mb-3">
                                <label for="CarNickname" class="form-label fw-semibold">Car Nickname</label>
                                <input type="text" class="form-control" id="CarNickname" name="CarNickname" 
                                       value="@Model.VehicleInfo.CarNickname">
                            </div>

                            <div class="mb-3">
                                <label for="PassengerCapacity" class="form-label fw-semibold">Passenger Capacity</label>
                                <select class="form-select" id="PassengerCapacity" name="PassengerCapacity" required>
                                    @for (int i = 1; i <= 20; i++)
                                    {
                                        if (i == Model.VehicleInfo.PassengerCapacity)
                                        {
                                            <option value="@i" selected>@i</option>
                                        }
                                        else
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                </select>
                                <div class="invalid-feedback">Please select passenger capacity</div>
                            </div>

                            <div class="mb-4">
                                <label for="FuelType" class="form-label fw-semibold">Fuel Type</label>
                                <select class="form-select" id="FuelType" name="FuelType" required>
                                    @if ((int)Model.VehicleInfo.FuelType == 0)
                                    {
                                        <option value="0" selected>Gasoline</option>
                                        <option value="1">Diesel</option>
                                        <option value="2">Electric</option>
                                        <option value="3">Hybrid</option>
                                    }
                                    else if ((int)Model.VehicleInfo.FuelType == 1)
                                    {
                                        <option value="0">Gasoline</option>
                                        <option value="1" selected>Diesel</option>
                                        <option value="2">Electric</option>
                                        <option value="3">Hybrid</option>
                                    }
                                    else if ((int)Model.VehicleInfo.FuelType == 2)
                                    {
                                        <option value="0">Gasoline</option>
                                        <option value="1">Diesel</option>
                                        <option value="2" selected>Electric</option>
                                        <option value="3">Hybrid</option>
                                    }
                                    else
                                    {
                                        <option value="0">Gasoline</option>
                                        <option value="1">Diesel</option>
                                        <option value="2">Electric</option>
                                        <option value="3" selected>Hybrid</option>
                                    }
                                </select>
                                <div class="invalid-feedback">Please select fuel type</div>
                            </div>

                            <input type="hidden" id="IsOverride" name="IsOverride" value="false" />

                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-lg me-2"></i>Save Vehicle Info
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-car-front text-muted fs-1 mb-3"></i>
                            <p class="text-muted">No vehicle found. Add a vehicle first.</p>
                            <a asp-controller="Garage" asp-action="AddVehicle" class="btn btn-outline-primary">
                                <i class="bi bi-plus-lg me-2"></i>Add Vehicle
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Favorite Trips Section -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-star-fill text-warning fs-4"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0">Favorite Trips</h5>
                    </div>

                    @if (Model.FavoriteTrips.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>From → To</th>
                                        <th>Distance</th>
                                        <th>Fuel</th>
                                        <th>Pax</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var trip in Model.FavoriteTrips)
                                    {
                                        <tr>
                                            <td>
                                                <div class="small text-truncate" style="max-width: 120px;">
                                                    <small>@trip.OriginName</small><br>
                                                    <i class="bi bi-arrow-down small text-muted"></i><br>
                                                    <small>@trip.DestinationName</small>
                                                </div>
                                            </td>
                                            <td><small>@trip.DistanceKm.ToString("F1") km</small></td>
                                            <td><small>@trip.FuelType</small></td>
                                            <td><small>@trip.PassengerCount</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-star text-muted fs-1 mb-3"></i>
                            <p class="text-muted">No favorite trips yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Danger Zone -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                        </div>
                        <h5 class="card-title fw-bold mb-0 text-danger">Danger Zone</h5>
                    </div>
                    <p class="text-muted mb-3">Once you delete your account, there is no going back. Please be certain.</p>
                    <button type="button" class="btn btn-danger" id="deleteAccountBtn">
                        <i class="bi bi-trash me-2"></i>Delete Account
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Account Confirmation Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-danger">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete your account? This action cannot be undone.</p>
                <p class="text-danger fw-semibold">All your data including vehicles, trips, and settings will be permanently deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="bi bi-trash me-2"></i>Yes, Delete My Account
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js"></script>
}
