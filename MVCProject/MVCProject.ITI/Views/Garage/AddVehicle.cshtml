@using MVCProject.ITI.DataAccessLayer.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@model MVCProject.ITI.ViewModels.AddVechileViewModel
@{
    ViewData["Title"] = "Add Vehicle";
    Layout = "_AppLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Garage,analytics.css" asp-append-version="true" />
}

<div class="page-wrap">

    <div class="page-top">
        <div>
            <h1 class="page-title">@(Model.VehicleId == Guid.Empty ? "Add Vehicle" : "Edit Vehicle")</h1>
            <p class="page-sub">@(Model.VehicleId == Guid.Empty ? "Register a new vehicle to your garage" : "Update your vehicle details")</p>
        </div>
    </div>

    <div class="add-vehicle-layout">

        <!-- ── FORM ── -->
        <div class="form-wrap">
            <form method="post" asp-action="@(Model.VehicleId == Guid.Empty ? "AddVehicle" : "Edit")">
                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                <input type="hidden" asp-for="VehicleId" />
                <input type="hidden" asp-for="CarModelId" />

                <div class="mb-3">
                    <div class="form-section-label">Nickname</div>
                    <input class="form-control-new" asp-for="NickName" id="prev-nickname" placeholder="e.g. My Toyota" />
                    <span asp-validation-for="NickName" class="text-danger" style="font-size:12px;"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-section-label">Brand</div>
                        <input class="form-control-new" asp-for="Make" id="prev-make" placeholder="e.g. Toyota" />
                        <span asp-validation-for="Make" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-section-label">Model</div>
                        <input class="form-control-new" asp-for="Model" id="prev-model" placeholder="e.g. Camry" />
                        <span asp-validation-for="Model" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-section-label">Year</div>
                        <input class="form-control-new" asp-for="Year" id="prev-year" placeholder="e.g. 2023" />
                        <span asp-validation-for="Year" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="form-section-label">Consumption (L/100km)</div>
                        <input class="form-control-new" asp-for="WltpMixed" id="prev-wltp" placeholder="e.g. 7.5" />
                        <span asp-validation-for="WltpMixed" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-section-label">Fuel Type</div>
                    <select asp-for="FuelType" id="FuelType" style="display:none;">
                        <option value="Gasoline">Gasoline</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Electric">Electric</option>
                        <option value="Hybrid">Hybrid</option>
                    </select>
                    <div class="fuel-selector">
                        <div class="fuel-option" data-value="Gasoline">
                            <i class="bi bi-fuel-pump-fill"></i> Gasoline
                        </div>
                        <div class="fuel-option" data-value="Diesel">
                            <i class="bi bi-droplet-fill"></i> Diesel
                        </div>
                        <div class="fuel-option" data-value="Electric">
                            <i class="bi bi-lightning-charge-fill"></i> Electric
                        </div>
                        <div class="fuel-option" data-value="Hybrid">
                            <i class="bi bi-leaf-fill"></i> Hybrid
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6" id="tankSection">
                        <div class="form-section-label">Tank Capacity (L)</div>
                        <input class="form-control-new" asp-for="TankCapacity" id="TankCapacity" placeholder="e.g. 60" />
                    </div>
                    <div class="col-md-6" id="batterySection" style="display:none;">
                        <div class="form-section-label">Battery Capacity (kWh)</div>
                        <input class="form-control-new" asp-for="BatteryCapacity" id="BatteryCapacity" placeholder="e.g. 75" />
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-section-label">Vehicle Color</div>
                    <input asp-for="ColorHex" type="hidden" id="colorInput" />
                    <span asp-validation-for="ColorHex" class="text-danger" style="font-size:12px;"></span>
                    <div class="color-picker">
                        <button type="button" class="color-swatch" style="background:#f0f0f0;" data-color="#f0f0f0"></button>
                        <button type="button" class="color-swatch" style="background:#1e293b;" data-color="#1e293b"></button>
                        <button type="button" class="color-swatch" style="background:#dc2626;" data-color="#dc2626"></button>
                        <button type="button" class="color-swatch" style="background:#2563eb;" data-color="#2563eb"></button>
                        <button type="button" class="color-swatch" style="background:#f59e0b;" data-color="#f59e0b"></button>
                        <button type="button" class="color-swatch" style="background:#7f1d1d;" data-color="#7f1d1d"></button>
                        <button type="button" class="color-swatch" style="background:#14532d;" data-color="#14532d"></button>
                        <button type="button" class="color-swatch" style="background:#ea580c;" data-color="#ea580c"></button>
                        <button type="button" class="color-swatch" style="background:#9333ea;" data-color="#9333ea"></button>
                        <button type="button" class="color-swatch" style="background:#0891b2;" data-color="#0891b2"></button>
                    </div>
                </div>

                <div class="form-actions-row">
                    <a asp-action="Garage" class="btn-cancel-new">Cancel</a>
                    <button class="btn-submit-new" type="submit">
                        <i class="bi bi-check2"></i>
                        @(Model.VehicleId == Guid.Empty ? "Add Vehicle" : "Save Changes")
                    </button>
                </div>

            </form>
        </div>

        <!-- ── LIVE PREVIEW SIDEBAR ── -->
        <div class="preview-sidebar">

            <div class="preview-label">Live Preview</div>

            <!-- preview card -->
            <div class="preview-vehicle-card">
                <div class="preview-accent" id="prev-accent" style="background:#0d9488;"></div>
                <div class="preview-card-inner">
                    <div class="preview-icon-wrap">
                        <i class="bi bi-car-front-fill preview-car-icon"></i>
                    </div>
                    <div class="preview-card-body">
                        <div class="preview-card-name" id="disp-nickname">My Vehicle</div>
                        <div class="preview-card-sub" id="disp-makemodel">Brand · Model · Year</div>
                        <div class="preview-chips">
                            <span class="preview-chip" id="disp-fuel">
                                <i class="bi bi-fuel-pump-fill"></i> Gasoline
                            </span>
                            <span class="preview-chip" id="disp-wltp">
                                <i class="bi bi-speedometer2"></i> — L/100km
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- stats summary -->
            <div class="preview-stats">
                <div class="preview-stat">
                    <div class="preview-stat-icon teal"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <div class="preview-stat-val" id="disp-year2">—</div>
                        <div class="preview-stat-label">Year</div>
                    </div>
                </div>
                <div class="preview-stat">
                    <div class="preview-stat-icon purple"><i class="bi bi-fuel-pump-fill"></i></div>
                    <div>
                        <div class="preview-stat-val" id="disp-fuel2">—</div>
                        <div class="preview-stat-label">Fuel Type</div>
                    </div>
                </div>
                <div class="preview-stat">
                    <div class="preview-stat-icon amber"><i class="bi bi-speedometer2"></i></div>
                    <div>
                        <div class="preview-stat-val" id="disp-wltp2">—</div>
                        <div class="preview-stat-label">L/100km</div>
                    </div>
                </div>
            </div>

            <!-- tip -->
            <div class="preview-tip">
                <i class="bi bi-lightbulb-fill"></i>
                Fill in the form to see your vehicle card update in real time.
            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script>
        // ── fuel selector ────────────────────────────
        const fuelSelect = document.getElementById("FuelType");
        const fuelOpts   = document.querySelectorAll(".fuel-option");

        const fuelIcons = {
            Gasoline: "bi-fuel-pump-fill",
            Diesel:   "bi-droplet-fill",
            Electric: "bi-lightning-charge-fill",
            Hybrid:   "bi-leaf-fill"
        };

        function syncFuelUI(val) {
            fuelOpts.forEach(o => o.classList.toggle("active", o.dataset.value === val));
            const tankDiv    = document.getElementById("tankSection");
            const batteryDiv = document.getElementById("batterySection");
            if (val === "Electric") {
                tankDiv.style.display    = "none";
                batteryDiv.style.display = "block";
            } else if (val === "Hybrid") {
                tankDiv.style.display    = "block";
                batteryDiv.style.display = "block";
            } else {
                tankDiv.style.display    = "block";
                batteryDiv.style.display = "none";
            }
            // update preview
            document.getElementById("disp-fuel").innerHTML  = `<i class="bi ${fuelIcons[val]}"></i> ${val}`;
            document.getElementById("disp-fuel2").textContent = val;
        }

        fuelOpts.forEach(o => o.addEventListener("click", () => {
            fuelSelect.value = o.dataset.value;
            syncFuelUI(o.dataset.value);
        }));

        syncFuelUI(fuelSelect.value || "Gasoline");

        // ── color swatches ───────────────────────────
        const swatches   = document.querySelectorAll(".color-swatch");
        const colorInput = document.getElementById("colorInput");

        swatches.forEach(s => {
            s.addEventListener("click", () => {
                swatches.forEach(x => x.classList.remove("active"));
                s.classList.add("active");
                colorInput.value = s.dataset.color;
                document.getElementById("prev-accent").style.background = s.dataset.color;
            });
            if (s.dataset.color === colorInput.value) s.classList.add("active");
        });

        // ── live preview ─────────────────────────────
        function val(id) { return document.getElementById(id)?.value?.trim() || ""; }

        function updatePreview() {
            const nick  = val("prev-nickname");
            const make  = val("prev-make");
            const model = val("prev-model");
            const year  = val("prev-year");
            const wltp  = val("prev-wltp");

            document.getElementById("disp-nickname").textContent =
                nick || "My Vehicle";

            const parts = [make, model, year].filter(Boolean);
            document.getElementById("disp-makemodel").textContent =
                parts.length ? parts.join(" · ") : "Brand · Model · Year";

            document.getElementById("disp-wltp").innerHTML =
                `<i class="bi bi-speedometer2"></i> ${wltp ? wltp + " L/100km" : "— L/100km"}`;

            document.getElementById("disp-year2").textContent  = year  || "—";
            document.getElementById("disp-wltp2").textContent  = wltp  || "—";
        }

        ["prev-nickname","prev-make","prev-model","prev-year","prev-wltp"]
            .forEach(id => document.getElementById(id)
                ?.addEventListener("input", updatePreview));

        updatePreview();

        // ── clear validation ─────────────────────────
        $(document).on("input change", "input, select", function () {
            $(this).closest("div").find(".field-validation-error").text("");
        });
    </script>
}
