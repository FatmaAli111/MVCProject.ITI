@model PaginatedResult<MVCProject.ITI.DataAccessLayer.Entities.Vehicle>
@{
    ViewData["Title"] = "Garage";
    Layout = "_AppLayout";
    var vehicles = Model.Data;
}
@section Styles {
    <link rel="stylesheet" href="~/css/Garage,analytics.css" asp-append-version="true" />
}

<div class="page-wrap">
    <div class="garage-header">
        <div>
            <h1 class="page-title">My Garage</h1>
            <p class="page-sub">@Model.TotalCount vehicle@(Model.TotalCount != 1 ? "s" : "") registered</p>
        </div>
        <a class="btn btn-teal" asp-controller="Garage" asp-action="AddVehicle">
            <i class="fa-solid fa-plus"></i> Add Vehicle
        </a>
    </div>

    <div class="vehicle-list">
        @foreach (var v in vehicles)
        {
            <div class="vehicle-card">
                <div class="vc-accent" style="background:@v.ColorHex;"></div>
                <div class="vehicle-icon">
                    <i class="bi bi-car-front-fill"></i>
                </div>
                <div class="vehicle-body">
                    <div class="vehicle-header">
                        <div class="vc-name-row">
                            <h3 class="vehicle-name">@v.NickName</h3>
                            @if (v.IsDefault)
                            {
                                <span class="default-badge">
                                    <i class="bi bi-star-fill" style="font-size:9px;"></i> Default
                                </span>
                            }
                        </div>
                        <p class="vc-year-model">@v.CarModel?.Year &nbsp;ù&nbsp; @v.CarModel?.Make @v.CarModel?.Model</p>
                    </div>
                    <div class="vc-chips">
                        <span class="vc-chip">
                            <i class="bi bi-fuel-pump-fill"></i> @v.CarModel?.FuelType
                        </span>
                        <span class="vc-chip">
                            <i class="bi bi-speedometer2"></i> @v.CarModel?.WltpMixed L/100km
                        </span>
                    </div>
                    <div class="vehicle-actions">
                        @if (!v.IsDefault)
                        {
                            <form method="post" asp-action="SetDefault" asp-route-id="@v.Id">
                                <button class="icon-btn default" title="Set as Default" type="submit">
                                    <i class="bi bi-star-fill"></i> Set Default
                                </button>
                            </form>
                        }
                        <a asp-action="Edit" asp-route-id="@v.Id" class="icon-btn edit" title="Edit">
                            <i class="bi bi-pencil-fill"></i> Edit
                        </a>
                        <form method="post" asp-action="DeleteVehicle" asp-route-id="@v.Id" style="display:inline;">
                            <button class="icon-btn delete" title="Delete" type="submit">
                                <i class="bi bi-trash3-fill"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (!vehicles.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fa-solid fa-car-side"></i>
                </div>
                <h3 class="empty-title">No vehicles yet</h3>
                <p class="empty-sub">Add your first vehicle to start tracking trips and expenses.</p>
                <a class="btn btn-teal" asp-controller="Garage" asp-action="AddVehicle">
                    <i class="fa-solid fa-plus"></i> Add Your First Vehicle
                </a>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        @await Html.PartialAsync("_AppPagination", Model)
    }
</div>
