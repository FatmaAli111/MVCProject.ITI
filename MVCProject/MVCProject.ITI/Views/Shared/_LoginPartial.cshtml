@using MVCProject.ITI.DataAccessLayer.Entities
@using Microsoft.AspNetCore.Identity
@using MVCProject.ITI.Constants
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="nav-auth-buttons d-flex align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var displayName = (!string.IsNullOrWhiteSpace(currentUser?.FullName))
        ? currentUser.FullName
        : User.Identity?.Name;
        <span class="nav-link nav-link-custom" style="cursor:default;">Hello, @displayName!</span>
        @if (await UserManager.IsInRoleAsync(currentUser!, RoleNames.Admin))
        {
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-auth btn-auth-outline">
                <i class="bi bi-shield-lock me-1"></i> Admin
            </a>
        }
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="margin:0;">
            <button type="submit" class="btn-auth btn-auth-outline">Logout</button>
        </form>
    }
    else
    {
        <a asp-area="Identity" asp-page="/Account/Login" class="btn-auth btn-auth-outline">Login</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn-auth btn-auth-primary">Register</a>
    }
</div>
