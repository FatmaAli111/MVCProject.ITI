@model TripCardViewModel
<div class="trip-item" id="unique-trip-card" style="display:flex; align-items:center; width: 100%;">
    <div class="trip-dot-static">
        <i class="bi bi-geo-alt-fill"></i>
    </div>
    <div class="trip-info" style="flex:1;">
        <div class="trip-route">@Model.OriginName <span class="via">to</span> @Model.DestinationName</div>
        <div class="trip-meta">@Model.TripDate.ToString("yyyy-MM-dd") &nbsp;·&nbsp; @Model.DistanceKm km &nbsp;·&nbsp; @Model.VehicleName</div>
    </div>
    <div class="fav-container">
        <button type="button" class="fav-btn @(Model.IsFavorite ? "active" : "")" 
                onclick="event.preventDefault(); event.stopPropagation(); toggleFavorite(this, '@Model.Id')" 
                aria-label="Toggle Favorite">
            <svg viewBox="0 0 24 24" fill="@(Model.IsFavorite ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.84-8.84 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
        </button>
    </div>
    <div class="trip-status-area" style="text-align:right; margin-left:8px;">
        <div class="trip-price">EGP @Model.TripTotalCost</div>
        <div class="priority-tag medium"></div>
    </div>
</div>
